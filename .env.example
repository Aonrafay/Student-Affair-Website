# Student Affairs CMS — environment variables
# Copy to `.env` and adjust for your MySQL / deployment.

# --- HTTP server ---
# Port the Express app listens on.
PORT=5000
# Mount path on the university site (no trailing slash). Every route, asset
# and API lives under this path. Changing it requires no code changes.
BASE_PATH=/student-affairs
# Random string used to sign admin JWT sessions.
JWT_SECRET=change-me-to-a-long-random-string

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=sa
DB_PASSWORD=sa
DB_NAME=student_affairs

# --- Seed accounts (only used by `npm run seed`) ---
ADMIN_EMAIL=admin@niit.edu.pk
ADMIN_PASSWORD=admin123
EDITOR_EMAIL=editor@niit.edu.pk
EDITOR_PASSWORD=editor123

# --- VM / production deployment ---
# Docker Compose reads this file automatically (`docker compose up`).
# On the VM, copy this to `.env` and change every secret below:
#   cp .env.example .env
JWT_SECRET=change-me-to-a-long-random-string
DB_PASSWORD=sa
ADMIN_PASSWORD=admin123
EDITOR_PASSWORD=editor123

# --- Uploads ---
# MAX_UPLOAD_BYTES: ceiling for ONE uploaded file. Bytes. 0 disables the
# per-file cap entirely (the media quota below still applies). There is no
# per-type limit any more - one number governs every upload.
MAX_UPLOAD_BYTES=4294967296

# UPLOADS_MAX_BYTES: ceiling for the media library as a whole. Bytes. 0
# disables it. This is the limit you actually control - without any ceiling a
# single upload can fill the volume, and once the volume is full MySQL cannot
# write either, so the whole site goes down rather than just the upload.
UPLOADS_MAX_BYTES=21474836480
