# Student Affairs CMS — environment variables
# Copy to `.env` and adjust for your MySQL / deployment.

# --- HTTP server ---
# Port the Express app listens on.
PORT=5000
# Mount path on the university site (no trailing slash). Every route, asset
# and API lives under this path. Changing it requires no code changes.
BASE_PATH=/student-affairs
# Random string used to sign admin JWT sessions.
JWT_SECRET=change-me-to-a-long-random-string

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=sa
DB_PASSWORD=sa
DB_NAME=student_affairs

# --- Seed accounts (only used by `npm run seed`) ---
ADMIN_EMAIL=admin@niit.edu.pk
ADMIN_PASSWORD=admin123
EDITOR_EMAIL=editor@niit.edu.pk
EDITOR_PASSWORD=editor123

# --- VM / production deployment ---
# Docker Compose reads this file automatically (`docker compose up`).
# On the VM, copy this to `.env` and change every secret below:
#   cp .env.example .env
JWT_SECRET=change-me-to-a-long-random-string
DB_PASSWORD=sa
ADMIN_PASSWORD=admin123
EDITOR_PASSWORD=editor123
